# Database
SPRING_DATASOURCE_USERNAME=original-username
SPRING_DATASOURCE_PASSWORD=original-password


# TMDB API
TMDB_API_KEY=your-tmdb-api-key-here

# JWT security (minimum 32 bytes; use a long random value in production)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=PT1H

# Production
VITE_API_URL=https://your-backend-domain.com/api/v1

# Initial Admin User (optional)
ADMIN_STARTUP_ENABLED=true
ADMIN_STARTUP_USERNAME=admin
ADMIN_STARTUP_PASSWORD=admin-password
ADMIN_STARTUP_EMAIL=admin@test.com
ADMIN_STARTUP_NAME="Admin User"

# Production
VITE_API_URL=https://your-backend-domain.com/api/v1

